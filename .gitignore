# This file tells Git which files shouldn't be added to source control

# https://huggingface.co/buckets/Sarverott/raw-law-of-poland - raw files of every source:
# DU/, MP/ (journals), sejm/ (work of Sejm); its README is kept here
resources/bucket/*
!resources/bucket/README.md

# https://huggingface.co/datasets/Sarverott/polish_national_law_docs
resources/dataset

# https://huggingface.co/spaces/Sarverott/docs-of-law-by-gov-in-poland
resources/space
# the conversations of the mastermind (phase 31): the local side of their dataset on Hugging
# Face (.map.json "conversations"); only its card is kept in git
resources/conversations/*
# what the executive agent wrote (phase 33): a person reads it there, git keeps none of it
resources/agent
# the simulation bubble and the proposals of the Python stack (phase 36), kept here only
resources/simulations
resources/proposals
# the torrents and their IPFS directory (phase 37, task torrents): made here, published by the owner
resources/torrents
!resources/conversations/README.md

# the directories of other sources before phase 10 (task resources:merge moves them into
# dataset/ and bucket/)
resources/sejm-dataset
resources/sejm-bucket
resources/saos-dataset

# compose services (phase 6): configs in resources/configs/<purpose>/ are kept in git;
# data of containers that must stay but never be pushed, one directory per volume
resources/.containerdatavol/*
!resources/.containerdatavol/README.md
# secrets generated at the first `task init`, one file each; .env overrides them
resources/secrets/*
!resources/secrets/README.md

# logs of runs (src/core/logging/setup.ts, LOG_DIR)
logs

.idea
dist
node_modules
storage

# tokens (HF_TOKEN)
.env

# astro keeps its generated types here
.astro

# workflows: build of nitro, its cache, and runs of the local world
src/workflows/.output
src/workflows/node_modules
.workflow-data
.swc

# made by task devlog:state, never kept in git (as in the BOS core)
docs/devlog/STATE.md

# the website, built by task docs:build
site/
docs/.venv
__pycache__/

# marimo notebooks made from examples/notebooks/ (task examples:convert)
examples/marimo
examples/.venv
# the environment of the Python stack (task python:sync)
stacks/python/.venv
