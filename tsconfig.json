{
	"extends": "@apify/tsconfig",
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"target": "ES2022",
		"outDir": "dist",
		"rootDir": "src",
		"tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
		"noUnusedLocals": false,
		"skipLibCheck": true,
		"lib": ["ES2022", "DOM"],
		"rewriteRelativeImportExtensions": true
	},
	"include": ["./src/**/*"],
	"exclude": [
		"./src/workflows/nitro.config.ts",
		"./src/workflows/.output",
		"./src/tui/index.tsx",
		"./src/tui/main.js",
		"./src/tui/termui.config.ts"
	]
}
