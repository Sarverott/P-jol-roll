# Settings of this machine. `task init` copies this file to .env once; every task reads .env
# (dotenv in Taskfile.yml), and a variable set in the shell wins over it. .env is ignored by git.
#
# Tokens: an empty value (spaces and tabs count as empty) turns off what needs the token,
# and nothing fails because of it.

# Hugging Face: `task resources:push` and private repositories (pull of public ones works without)
HF_TOKEN=
# GitHub: for tools that talk to the repository (gh); nothing in the code needs it yet
GH_TOKEN=
# models for the services of phase 6 (llms-api-host); nothing in the code needs them yet
OLLAMA_TOKEN=
OPENAI_TOKEN=

# where gathered data lives - another disk or a drive (docs/guides/second-machine.md)
# RESOURCES_DIR=/media/you/drive/p-jol-roll-resources

# logs: every run writes logs/log-<Date.now()>-<log mode>-<command>.log (LOG_DIR=off: none);
# LOG_LEVEL is the log mode: error, warn, info (default), debug, verbose; json gives one object
# a line; SYSLOG_ADDRESS sends each line to syslog too (log-collector, udp://127.0.0.1:5514)
LOG_DIR=logs
LOG_LEVEL=info
# LOG_FORMAT=json
# SYSLOG_ADDRESS=udp://127.0.0.1:5514

# the http api (task serve)
# HOST=127.0.0.1
# PORT=8080

# a copy of a source instead of the real one (tests use these)
# ELI_API=https://api.sejm.gov.pl/eli
# SEJM_API=https://api.sejm.gov.pl/sejm
# SAOS_API=https://www.saos.org.pl/api

# compose services on this machine (phase 6): ports of routing-proxy and internal-dns
# ROUTING_PORT=80
# DNS_PORT=15353
