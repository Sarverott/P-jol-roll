{
	"manifest_version": 3,
	"name": "P_JOL_ROLL",
	"version": "0.20.7",
	"description": "Looks up an act of Polish journals of laws in a P_JOL_ROLL host: status, ties, text.",
	"icons": {
		"48": "icons/icon-48.png",
		"96": "icons/icon-96.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_popup": "popup.html",
		"default_title": "P_JOL_ROLL",
		"default_icon": { "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
	},
	"permissions": ["activeTab", "storage"],
	"host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
	"optional_host_permissions": ["https://*/*"],
	"browser_specific_settings": {
		"gecko": {
			"id": "p-jol-roll@sarverott.github.io",
			"strict_min_version": "128.0"
		}
	}
}
