---
// NOTE: ow... alright then, cool that you consider coolify ^^
// NOTE: this will be selfhosted best case for coolify, docker apps etc. - api mode also here
import Viewer from "../../gui/index.vue";
import { credits } from "../data/credits.ts";
import { at, site } from "../data/site.ts";

// built as static files into dist/web; the api (src/openapi) serves them next to /api,
// so one container is website and api at once. PUBLIC_API points the viewer elsewhere
const api = import.meta.env.PUBLIC_API ?? "";
// NOTE: can we read it and other data bbelow from yaml file or at least js file imports? i thought about something static but then i spot that templating strings there...
// ANSWER: done - the words are in data/site.yaml; what needs the host (the whole addresses of a
// card, PUBLIC_SITE or the demo) is made in data/site.ts, so the yaml stays plain data
---

<html lang="pl">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{site.name}</title>
		<meta name="description" content={site.description}>
		<meta name="theme-color" content={site.theme}>
		<link rel="manifest" href="/manifest.webmanifest">
		<!-- the images of the project: scripts/devops/media/build.sh, in src/web/public -->
		<link rel="icon" href="/favicon.ico" sizes="48x48">
		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
		<link rel="apple-touch-icon" href="/apple-touch-icon.png">
		<link rel="sitemap" href="/sitemap.xml">
		<meta property="og:type" content="website">
		<meta property="og:site_name" content={site.name}>
		<meta property="og:title" content={site.title}>
		<meta property="og:description" content={site.description}>
		<meta property="og:url" content={at("/")}>
		<meta property="og:image" content={at(`/${site.card.image}`)}>
		<meta property="og:image:width" content={String(site.card.width)}>
		<meta property="og:image:height" content={String(site.card.height)}>
		<meta property="og:image:alt" content={site.card.alt}>
		<meta name="twitter:card" content="summary_large_image">
	</head>
	<body>
		<Viewer client:only="vue" api={api} credits={credits} />
	</body>
</html>
