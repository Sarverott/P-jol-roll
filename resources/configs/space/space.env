# The demo space and the release it runs. Read by scripts/devops/release/space.sh (task
# resources:space, task resources:space:refresh, the release workflow); a variable already set
# in the environment wins over the line here.
# the space on Hugging Face (resources/.map.json names the same)
SPACE_REPO=Sarverott/docs-of-law-by-gov-in-poland
# the release of the image the space builds from: empty means the newest tag v<version>
P_JOL_ROLL_VERSION=
